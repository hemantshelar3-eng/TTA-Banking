<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TTA Bank Smoke" parallel="classes" thread-count="3" verbose="1">
  <listeners>
    <listener class-name="com.tta.bank.listeners.TestListener"/>
  </listeners>
  <test name="TTA Bank - Smoke">
    <groups>
      <run><include name="smoke"/><exclude name="known-defect"/></run>
    </groups>
    <packages>
      <package name="com.tta.bank.tests"/>
    </packages>
  </test>
</suite>
