<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Main regression suite. Tests tagged "known-defect" (real app bugs from your Excel sheet) are excluded. -->
<suite name="TTA Bank Regression" parallel="classes" thread-count="3" verbose="1">
  <listeners>
    <listener class-name="com.tta.bank.listeners.TestListener"/>
  </listeners>

  <test name="TTA Bank - UI Regression">
    <groups>
      <run>
        <include name="smoke"/>
        <include name="regression"/>
        <exclude name="known-defect"/>
      </run>
    </groups>
    <classes>
      <class name="com.tta.bank.tests.LoginTests"/>
      <class name="com.tta.bank.tests.RegistrationTests"/>
      <class name="com.tta.bank.tests.SendMoneyTests"/>
      <class name="com.tta.bank.tests.QrPaymentTests"/>
      <class name="com.tta.bank.tests.TransactionsTests"/>
      <class name="com.tta.bank.tests.SessionAndUiTests"/>
    </classes>
  </test>
</suite>
